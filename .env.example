# PriceHubble-Zugang. Nicht eingecheckt; Werte in .env.local eintragen.
# Beschaffung: Zugang des Auftraggebers. Ohne diese Werte laeuft die
# Anwendung im Mock-Betrieb (siehe VALUATION_PROVIDER).
# Namen entsprechen der Bruno-Collection (vars:secret ph_*).
PH_BASE_URL=
PH_USERNAME=
PH_PASSWORD=

# Alternative zu PH_USERNAME/PH_PASSWORD: ein von Hand besorgter Token, etwa aus
# einem Login in der Bruno-Collection. Ist er gesetzt, entfaellt der Login und die
# Zugangsdaten werden nicht mehr verlangt; PH_BASE_URL und PH_DOSSIER_ID bleiben
# Pflicht. Gedacht fuer einmalige Laeufe gegen die echte API, ohne dass
# Zugangsdaten auf die Platte kommen. Wird der Token abgelehnt, bricht der Aufruf
# ohne zweiten Versuch ab -- ein fester Token laesst sich nicht erneuern.
PH_ACCESS_TOKEN=

# Bezeichner des Test-Dossiers, gegen das der Adapter arbeitet.
# Fehlt der Wert bei VALUATION_PROVIDER=pricehubble, ist das ein
# Konfigurationsfehler und der Start bricht ab.
PH_DOSSIER_ID=

# Auswahl der ValuationProvider-Implementierung. Drei Werte:
# mock        = MockValuationProvider auf Interface-Ebene, umgeht die
#               Schemavalidierung (Standard)
# fixture     = aufgezeichnete Antworten ueber MSW auf HTTP-Ebene,
#               Schemavalidierung laeuft mit
# pricehubble = echte API (benoetigt PH_*-Zugangsdaten)
VALUATION_PROVIDER=mock

# Pfad zur fachlichen Laufzeitkonfiguration (NFA-04).
COMPANY_DEFAULTS_PATH=./config/company-defaults.json

# Ablage der erzeugten Offert-Artefakte (A-12, Brief 5.8).
OFFERTEN_VERZEICHNIS=./data/offerten

# Ablage der Projekte (veraenderliche Arbeitsstaende, im Unterschied zur
# append-only Offertenablage).
PROJEKTE_VERZEICHNIS=./data/projekte

# Pfad zur Offerttext-Vorlage (Spec 2026-08-27). Fehlt die Datei, gilt die
# eingebaute Neubau-Standardvorlage; gespeichert wird erst beim ersten Sichern
# im Einstellungsbereich.
OFFERT_VORLAGE_PATH=

# Pfad auf das Berichtsrepository der Bachelorarbeit. Die Auswertungswerkzeuge
# legen dort Anhangsartefakte und Tabellen ab. Nur fuer Auswertungslaeufe
# noetig; die Anwendung selbst liest den Wert nicht (PE-24).
BA_MAIN=
